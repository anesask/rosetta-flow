# Copy to .env (same folder) and fill in. Never commit .env.

# OpenAI-compatible endpoint. Default: CSCS inference API (Hack Apertus).
LLM_BASE_URL=https://api.inference.cscs.ch/v1
# Model name + version, exactly as listed by GET /v1/models
LLM_NAME=swiss-ai/Apertus-v1.5-8B
LLM_API_KEY=

# Optional: local Apertus 8B (+ LoRA adapter) for on-prem / air-gapped runs
# LOCAL_MODEL_PATH=
